---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorHeader from "../../components/author/AuthorHeader.astro";
import AuthorProfile from "../../components/author/AuthorProfile.astro";
import AuthorStats from "../../components/author/AuthorStats.astro";
import "../../styles/author-theme.css";
---

<BaseLayout title="author page" description="description for author page">
  <body
    class="bg-background-light dark:bg-background-dark min-h-screen antialiased flex flex-col font-body text-text-main selection:bg-primary/30 selection:text-primary"
  >
    <AuthorHeader />

    <main class="grow flex flex-col items-center py-16 px-6 lg:py-24">
      <div
        class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24"
      >
        <AuthorProfile />
        <AuthorStats />
      </div>
    </main>
  </body>
</BaseLayout>

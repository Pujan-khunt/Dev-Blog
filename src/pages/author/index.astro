---
import "../../styles/author-theme.css";
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>The Terminal Ledger - Author Profile</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;600;700&family=General+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background-light dark:bg-background-dark min-h-screen antialiased flex flex-col font-body text-text-main selection:bg-primary/30 selection:text-primary"
  >
    <!-- Header -->
    <header
      class="border-b border-border-color sticky top-0 bg-background-dark/95 backdrop-blur-xs z-50"
    >
      <div
        class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between"
      >
        <div class="flex items-center gap-4">
          <div class="text-text-main">
            <svg
              class="size-6"
              fill="none"
              viewBox="0 0 48 48"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M39.5563 34.1455V13.8546C39.5563 15.708 36.8773 17.3437 32.7927 18.3189C30.2914 18.916 27.263 19.2655 24 19.2655C20.737 19.2655 17.7086 18.916 15.2073 18.3189C11.1227 17.3437 8.44365 15.708 8.44365 13.8546V34.1455C8.44365 35.9988 11.1227 37.6346 15.2073 38.6098C17.7086 39.2069 20.737 39.5564 24 39.5564C27.263 39.5564 30.2914 39.2069 32.7927 38.6098C36.8773 37.6346 39.5563 35.9988 39.5563 34.1455Z"
                fill="currentColor"></path>
              <path
                clip-rule="evenodd"
                d="M10.4485 13.8519C10.4749 13.9271 10.6203 14.246 11.379 14.7361C12.298 15.3298 13.7492 15.9145 15.6717 16.3735C18.0007 16.9296 20.8712 17.2655 24 17.2655C27.1288 17.2655 29.9993 16.9296 32.3283 16.3735C34.2508 15.9145 35.702 15.3298 36.621 14.7361C37.3796 14.246 37.5251 13.9271 37.5515 13.8519C37.5287 13.7876 37.4333 13.5973 37.0635 13.2931C36.5266 12.8516 35.6288 12.3647 34.343 11.9175C31.79 11.0295 28.1333 10.4437 24 10.4437C19.8667 10.4437 16.2099 11.0295 13.657 11.9175C12.3712 12.3647 11.4734 12.8516 10.9365 13.2931C10.5667 13.5973 10.4713 13.7876 10.4485 13.8519ZM37.5563 18.7877C36.3176 19.3925 34.8502 19.8839 33.2571 20.2642C30.5836 20.9025 27.3973 21.2655 24 21.2655C20.6027 21.2655 17.4164 20.9025 14.7429 20.2642C13.1498 19.8839 11.6824 19.3925 10.4436 18.7877V34.1275C10.4515 34.1545 10.5427 34.4867 11.379 35.027C12.298 35.6207 13.7492 36.2054 15.6717 36.6644C18.0007 37.2205 20.8712 37.5564 24 37.5564C27.1288 37.5564 29.9993 37.2205 32.3283 36.6644C34.2508 36.2054 35.702 35.6207 36.621 35.027C37.4573 34.4867 37.5485 34.1546 37.5563 34.1275V18.7877ZM41.5563 13.8546V34.1455C41.5563 36.1078 40.158 37.5042 38.7915 38.3869C37.3498 39.3182 35.4192 40.0389 33.2571 40.5551C30.5836 41.1934 27.3973 41.5564 24 41.5564C20.6027 41.5564 17.4164 41.1934 14.7429 40.5551C12.5808 40.0389 10.6502 39.3182 9.20848 38.3869C7.84205 37.5042 6.44365 36.1078 6.44365 34.1455L6.44365 13.8546C6.44365 12.2684 7.37223 11.0454 8.39581 10.2036C9.43325 9.3505 10.8137 8.67141 12.343 8.13948C15.4203 7.06909 19.5418 6.44366 24 6.44366C28.4582 6.44366 32.5797 7.06909 35.657 8.13948C37.1863 8.67141 38.5667 9.3505 39.6042 10.2036C40.6278 11.0454 41.5563 12.2684 41.5563 13.8546Z"
                fill="currentColor"
                fill-rule="evenodd"></path>
            </svg>
          </div>
          <a
            class="font-display font-semibold text-2xl tracking-tight hover:text-primary transition-colors duration-200"
            href="#">The Terminal Ledger</a
          >
        </div>
        <nav class="hidden md:flex items-center gap-8 font-mono text-sm">
          <a
            class="text-muted hover:text-primary transition-colors duration-200"
            href="#">[home]</a
          >
          <a
            class="text-muted hover:text-primary transition-colors duration-200"
            href="#">[archive]</a
          >
          <a class="text-primary transition-colors duration-200" href="#"
            >[author]</a
          >
        </nav>
      </div>
    </header>
    <!-- Main Content -->
    <main class="grow flex flex-col items-center py-16 px-6 lg:py-24">
      <div
        class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24"
      >
        <!-- Left Column: Biography -->
        <div class="flex flex-col space-y-12">
          <div>
            <h1
              class="font-mono text-muted text-sm tracking-widest uppercase mb-6"
            >
              &gt; _author_profile
            </h1>
            <div
              class="font-body text-[24px] leading-relaxed text-text-main font-normal space-y-8"
            >
              <p>
                Senior systems engineer and technical writer focusing on <span
                  class="text-primary font-medium">distributed systems</span
                >, <span class="text-primary font-medium">Rust</span>, and
                infrastructure architecture.
              </p>
              <p>
                Currently building resilient data pipelines at a global fintech
                organization. Previously spent 6 years architecting
                high-throughput microservices and untangling legacy monoliths.
              </p>
              <p>
                This ledger serves as a public notebook for complex engineering
                challenges, post-mortems, and architectural deep-dives.
              </p>
            </div>
          </div>
          <!-- Contact Links -->
          <div class="pt-8 border-t border-border-color">
            <h2 class="font-mono text-muted text-[13px] mb-6">
              // contact_protocols
            </h2>
            <ul
              class="space-y-4 font-mono text-[15px] flex flex-col items-start"
            >
              <li>
                <a
                  class="text-text-main link-underline"
                  href="https://github.com">github.com/alex-ledger</a
                >
              </li>
              <li>
                <a
                  class="text-text-main link-underline"
                  href="https://twitter.com">twitter.com/sys_alex</a
                >
              </li>
              <li>
                <a
                  class="text-text-main link-underline"
                  href="mailto:contact@terminalledger.net"
                  >mailto:contact@terminalledger.net</a
                >
              </li>
            </ul>
          </div>
        </div>
        <!-- Right Column: Stats Grid -->
        <div class="flex flex-col pt-12 lg:pt-0">
          <div
            class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-border-color border border-border-color"
          >
            <!-- Stat Item 1 -->
            <div
              class="bg-background-dark p-8 flex flex-col justify-between aspect-square group hover:bg-surface transition-colors duration-300"
            >
              <span
                class="font-mono text-muted text-[13px] group-hover:text-primary transition-colors duration-300"
                >sys.commits_total</span
              >
              <span
                class="font-display text-[48px] font-bold text-text-main leading-none mt-auto"
                >14.2k</span
              >
            </div>
            <!-- Stat Item 2 -->
            <div
              class="bg-background-dark p-8 flex flex-col justify-between aspect-square group hover:bg-surface transition-colors duration-300"
            >
              <span
                class="font-mono text-muted text-[13px] group-hover:text-primary transition-colors duration-300"
                >ledger.entries</span
              >
              <span
                class="font-display text-[48px] font-bold text-text-main leading-none mt-auto"
                >128</span
              >
            </div>
            <!-- Stat Item 3 -->
            <div
              class="bg-background-dark p-8 flex flex-col justify-between aspect-square group hover:bg-surface transition-colors duration-300"
            >
              <span
                class="font-mono text-muted text-[13px] group-hover:text-primary transition-colors duration-300"
                >sys.uptime_years</span
              >
              <span
                class="font-display text-[48px] font-bold text-text-main leading-none mt-auto"
                >11</span
              >
            </div>
            <!-- Stat Item 4 -->
            <div
              class="bg-background-dark p-8 flex flex-col justify-between aspect-square group hover:bg-surface transition-colors duration-300"
            >
              <span
                class="font-mono text-muted text-[13px] group-hover:text-primary transition-colors duration-300"
                >infra.deployments</span
              >
              <span
                class="font-display text-[48px] font-bold text-text-main leading-none mt-auto"
                >4,892</span
              >
            </div>
          </div>
          <div class="mt-8 flex justify-end">
            <span
              class="font-mono text-muted text-xs opacity-50 flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-[14px]">sync</span>
              Data last synced: 2023-10-27T14:32:00Z
            </span>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthorHeader from "@/components/author/AuthorHeader.astro";
import LeftSidebar from "@/components/home/LeftSidebar.astro";
import ArticleFeedColumn from "@/components/home/ArticleFeedColumn.astro";
---

<BaseLayout title="Home Page" description="Home Page Description">
  <body
    class="bg-background-dark min-h-screen selection:bg-primary selection:text-white flex flex-col items-center"
  >
    <AuthorHeader />

    <main
      class="w-full max-w-[1040px] mx-auto flex flex-col md:flex-row flex-1"
    >
      <LeftSidebar />
      <ArticleFeedColumn />
    </main>
  </body>
</BaseLayout>

---
import "../styles/home-theme.css";
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>The Terminal Ledger</title>
    <!-- Google Fonts: Space Grotesk, General Sans (using Inter as fallback), JetBrains Mono -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background-dark min-h-screen selection:bg-primary selection:text-white flex flex-col items-center"
  >
    <!-- Site Header -->
    <header
      class="w-full border-b border-border-color sticky top-0 bg-background-dark z-50"
    >
      <div
        class="max-w-[1040px] mx-auto px-6 py-4 flex items-center justify-between"
      >
        <div class="flex items-center gap-3">
          <span
            aria-hidden="true"
            class="material-symbols-outlined text-text-main text-2xl"
            >terminal</span
          >
          <h1
            class="font-display font-semibold text-2xl text-text-main tracking-tight"
          >
            The Terminal Ledger
          </h1>
        </div>
      </div>
    </header>
    <!-- Main Layout Grid -->
    <main
      class="w-full max-w-[1040px] mx-auto flex flex-col md:flex-row flex-1"
    >
      <!-- Left Sidebar (Navigation & Tags) -->
      <aside
        class="w-full md:w-[280px] border-b md:border-b-0 md:border-r border-border-color shrink-0 pt-6 md:pt-12 px-6 overflow-x-auto hide-scrollbar flex md:block flex-row gap-6 md:gap-0"
      >
        <!-- Main Nav -->
        <nav
          class="flex md:flex-col gap-2 mb-0 md:mb-12 shrink-0 border-r md:border-r-0 border-border-color pr-6 md:pr-0"
        >
          <a
            class="flex items-center gap-3 px-3 py-2 bg-surface border border-border-color text-text-main group transition-none"
            href="#"
          >
            <span aria-hidden="true" class="material-symbols-outlined text-lg"
              >home</span
            >
            <span
              class="font-mono text-sm tracking-wide group-hover:text-primary transition-none"
              >Home</span
            >
          </a>
          <a
            class="flex items-center gap-3 px-3 py-2 text-muted hover:bg-surface hover:text-text-main group transition-none"
            href="#"
          >
            <span aria-hidden="true" class="material-symbols-outlined text-lg"
              >folder_open</span
            >
            <span
              class="font-mono text-sm tracking-wide group-hover:text-primary transition-none"
              >Archive</span
            >
          </a>
          <a
            class="flex items-center gap-3 px-3 py-2 text-muted hover:bg-surface hover:text-text-main group transition-none"
            href="#"
          >
            <span aria-hidden="true" class="material-symbols-outlined text-lg"
              >person</span
            >
            <span
              class="font-mono text-sm tracking-wide group-hover:text-primary transition-none"
              >Author Ledger</span
            >
          </a>
        </nav>
        <!-- Tags Filter -->
        <div class="flex md:flex-col shrink-0 gap-4">
          <h2
            class="hidden md:block font-mono text-xs text-muted uppercase tracking-widest mb-2 px-3"
          >
            Taxonomy
          </h2>
          <div class="flex md:flex-col gap-2 flex-wrap">
            <a
              class="nav-tag group font-mono text-sm px-3 py-1 cursor-pointer transition-none"
              href="#"
            >
              <span class="bracket text-muted transition-none">[</span><span
                class="text text-muted transition-none">rust</span
              ><span class="bracket text-muted transition-none">]</span>
            </a>
            <a
              class="nav-tag group font-mono text-sm px-3 py-1 cursor-pointer transition-none"
              href="#"
            >
              <span class="bracket text-muted transition-none">[</span><span
                class="text text-muted transition-none">system-design</span
              ><span class="bracket text-muted transition-none">]</span>
            </a>
            <a
              class="nav-tag group font-mono text-sm px-3 py-1 cursor-pointer transition-none"
              href="#"
            >
              <span class="bracket text-muted transition-none">[</span><span
                class="text text-muted transition-none">architecture</span
              ><span class="bracket text-muted transition-none">]</span>
            </a>
            <a
              class="nav-tag group font-mono text-sm px-3 py-1 cursor-pointer transition-none"
              href="#"
            >
              <span class="bracket text-muted transition-none">[</span><span
                class="text text-muted transition-none">vim</span
              ><span class="bracket text-muted transition-none">]</span>
            </a>
            <a
              class="nav-tag group font-mono text-sm px-3 py-1 cursor-pointer transition-none"
              href="#"
            >
              <span class="bracket text-muted transition-none">[</span><span
                class="text text-muted transition-none">concurrency</span
              ><span class="bracket text-muted transition-none">]</span>
            </a>
          </div>
        </div>
      </aside>
      <!-- Article Feed Column -->
      <section class="w-full max-w-[720px] pt-8 md:pt-12 px-6 md:px-12 pb-24">
        <div class="flex flex-col gap-12 md:gap-16">
          <!-- Article Card 1 -->
          <article class="group cursor-pointer">
            <div class="font-mono text-[13px] text-muted mb-3 tracking-wide">
              <time datetime="2023-10-24">2023.10.24</time> // EXCERPT
            </div>
            <a class="block" href="#">
              <h2
                class="font-display text-2xl md:text-[28px] leading-tight text-text-main group-hover:text-primary transition-none mb-4"
              >
                Building a Concurrent Web Server in Rust: A Brutalist Approach
              </h2>
              <p
                class="font-body text-base md:text-lg text-muted leading-[1.6]"
              >
                Exploring the raw primitives of threading and asynchronous I/O
                in Rust without relying on heavy frameworks. We examine the
                standard library, mutexes, and channel communication to serve
                thousands of requests with minimal overhead.
              </p>
            </a>
          </article>
          <div class="w-full h-px bg-border-color"></div>
          <!-- Article Card 2 -->
          <article class="group cursor-pointer">
            <div class="font-mono text-[13px] text-muted mb-3 tracking-wide">
              <time datetime="2023-09-12">2023.09.12</time> // EXCERPT
            </div>
            <a class="block" href="#">
              <h2
                class="font-display text-2xl md:text-[28px] leading-tight text-text-main group-hover:text-primary transition-none mb-4"
              >
                Notes on Distributed Systems Architecture
              </h2>
              <p
                class="font-body text-base md:text-lg text-muted leading-[1.6]"
              >
                A collection of heuristics and architectural patterns for
                scaling systems across multiple geographic regions. Focusing on
                eventual consistency, vector clocks, and gracefully degrading
                under partition failures.
              </p>
            </a>
          </article>
          <div class="w-full h-px bg-border-color"></div>
          <!-- Article Card 3 -->
          <article class="group cursor-pointer">
            <div class="font-mono text-[13px] text-muted mb-3 tracking-wide">
              <time datetime="2023-08-05">2023.08.05</time> // EXCERPT
            </div>
            <a class="block" href="#">
              <h2
                class="font-display text-2xl md:text-[28px] leading-tight text-text-main group-hover:text-primary transition-none mb-4"
              >
                Vim as an IDE: The Minimalist Configuration
              </h2>
              <p
                class="font-body text-base md:text-lg text-muted leading-[1.6]"
              >
                Stripping away bloated plugins to rely on native Vim features. A
                deep dive into LSP integration, native netrw for file exploring,
                and leveraging the quickfix list for seamless compiler
                integration.
              </p>
            </a>
          </article>
          <div class="w-full h-px bg-border-color"></div>
          <!-- Loading State Indicator (Decorative) -->
          <div class="font-mono text-muted text-sm mt-8">
            <span>_</span>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

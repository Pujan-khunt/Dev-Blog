---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.isDraft)
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  );

type Posts = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts: Posts = {};

data.forEach((post) => {
  const year = post.data.publishedDate.getFullYear().toString();
  if (!posts[year]) {
    posts[year] = [];
  }
  posts[year].push(post);
});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

const title = "Blog | DevBlog";
const description = "A collection of thoughts on software development, coding, and technology.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold text-secondary dark:text-primary mb-4">
        Blog
      </h1>
      <p class="text-lg text-text-muted dark:text-gray-400">
        Thoughts on software development, coding, and technology.
      </p>
    </header>

    {years.map((year: string) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-secondary dark:text-primary mb-6 pb-2 border-b border-bg-secondary dark:border-gray-700">
          {year}
        </h2>

        <ul class="space-y-6">
          {posts[year].map((post) => (
            <li class="group">
              <a
                href={`/blog/${post.slug}`}
                class="block p-6 rounded-xl bg-bg-secondary dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all duration-300"
              >
                <article>
                  <div class="flex items-start justify-between gap-4 mb-2">
                    <h3 class="text-xl font-semibold text-text dark:text-gray-100 group-hover:text-primary dark:group-hover:text-primary transition-colors">
                      {post.data.title}
                    </h3>
                    <time
                      datetime={post.data.publishedDate.toISOString()}
                      class="text-sm text-text-muted dark:text-gray-400 whitespace-nowrap"
                    >
                      {post.data.publishedDate.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </div>
                  <p class="text-text-muted dark:text-gray-400 mb-4 line-clamp-2">
                    {post.data.description}
                  </p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="text-xs px-2 py-1 rounded-full bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary/80">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </article>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

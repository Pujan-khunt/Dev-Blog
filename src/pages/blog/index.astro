const rustCode = `<code class="language-rust"><span class="token keyword">pub enum</span> <span class="token class-name">NodeState</span> {
    <span class="token class-name">Follower</span>,
    <span class="token class-name">Candidate</span>,
    <span class="token class-name">Leader</span>,
}

<span class="token keyword">pub struct</span> <span class="token class-name">RaftNode</span> {
    <span class="token comment">// Persistent state on all servers</span>
    current_term: <span class="token class-name">u64</span>,
    voted_for: <span class="token class-name">Option</span>&lt;<span class="token class-name">NodeId</span>&gt;,
    log: <span class="token class-name">Vec</span>&lt;<span class="token class-name">LogEntry</span>&gt;,

    <span class="token comment">// Volatile state on all servers</span>
    commit_index: <span class="token class-name">u64</span>,
    last_applied: <span class="token class-name">u64</span>,
    
    <span class="token comment">// Current operational state</span>
    state: <span class="token class-name">NodeState</span>,
}</code>`;

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/blog/Navbar.astro";
import ArticleHeader from "@/components/blog/ArticleHeader.astro";
import ArticleContent from "@/components/blog/ArticleContent.astro";
import ArticleFooter from "@/components/blog/ArticleFooter.astro";

const title =
  "Building Resilient Distributed Systems: A Practical Guide to Raft";
const metadata = [
  { field: "AUTHOR", value: "Alice Engineer" },
  { field: "DATE", value: "2023-10-28" },
  { field: "READ_TIME", value: "14m" },
];
---

<BaseLayout title="Blog Page" description="description for blog page">
  <body
    class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col"
  >
    <Navbar />

    <main class="flex-1 w-full py-16 px-4 md:px-6">
      <ArticleHeader {title} {metadata} />

      <ArticleContent />

      <ArticleFooter />
    </main>
  </body>
</BaseLayout>

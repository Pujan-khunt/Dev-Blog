---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import AuthorBio from "@/components/AuthorBio.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const blogPosts: CollectionEntry<"blog">[] = (
    await getCollection("blog")
  ).filter((post) => !post.data.isDraft);

  return blogPosts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.slug },
    props: { blogPostCollectionEntry: post },
  }));
};

type Props = {
  blogPostCollectionEntry: CollectionEntry<"blog">;
};

const { blogPostCollectionEntry } = Astro.props as Props;
const { Content, headings } = await blogPostCollectionEntry.render();

const post = blogPostCollectionEntry.data;

if (!post) {
  throw new Error("No such post found");
}

function calculateReadingTime(content: string): string {
  const wordsPerMinute = 200;
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}

const readingTime = calculateReadingTime(blogPostCollectionEntry.body);
---

<BaseLayout title={post.title} description={post.description} image={post.heroImage?.src}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12 max-w-[1152px] mx-auto">
      <div class="min-w-0">
        {post.heroImage && (
          <div class="mb-8">
            <Image
              src={post.heroImage.src}
              alt={post.heroImage.alt}
              width={1024}
              height={576}
              class="w-full h-auto rounded-xl object-cover aspect-video"
            />
          </div>
        )}

        <header class="mb-8">
          <h1 class="text-3xl sm:text-4xl font-bold text-secondary dark:text-primary mb-4 leading-tight">
            {post.title}
          </h1>

          <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted dark:text-gray-400">
            <time datetime={post.publishedDate.toISOString()}>
              {post.publishedDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>

            {post.readingTime && (
              <>
                <span class="text-primary">•</span>
                <span>{readingTime}</span>
              </>
            )}

            {post.tags && post.tags.length > 0 && (
              <>
                <span class="text-primary">•</span>
                <div class="flex gap-2">
                  {post.tags.map((tag) => (
                    <span class="text-primary dark:text-primary/80">#{tag}</span>
                  ))}
                </div>
              </>
            )}
          </div>
        </header>

        <div class="prose-custom prose-lg dark:prose-invert max-w-none">
          <Content />
        </div>

        {post.author && <AuthorBio author={post.author} />}
      </div>

      <aside class="hidden lg:block">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </article>
</BaseLayout>

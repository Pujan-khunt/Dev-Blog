---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Generate all prerendered html pages for each blog entry in the blog collection
export const getStaticPaths: GetStaticPaths = async () => {
  // Fetch all non-draft blog posts using the collections API for creating all prerendered pages
  const blogPosts: CollectionEntry<"blog">[] = (
    await getCollection("blog")
  ).filter((post) => !post.data.isDraft);

  // Use slug from frontmatter (generated by Astro) for prerendered page params
  // Also pass all frontmatter to each blog post.
  return blogPosts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.slug },
    props: { blogPostCollectionEntry: post },
  }));
};

// Explicitly infer type of blog post collection entry
type Props = {
  blogPostCollectionEntry: CollectionEntry<"blog">;
};

// Blog post frontmatter recieved by this component
const { blogPostCollectionEntry } = Astro.props as Props;

// Frontmatter data
const post: CollectionEntry<"blog">["data"] = blogPostCollectionEntry.data;

if (!post) {
  throw new Error("No such post found");
}

// Markdown content from blog post.
const { Content } = await blogPostCollectionEntry.render();
---

<BaseLayout>
  <article>
    <img src={post.heroImage?.src} alt={post.heroImage?.alt} />
    <h1>{post.title}</h1>
    <p>{post.description}</p>
    <div><Content /></div>
  </article>
</BaseLayout>

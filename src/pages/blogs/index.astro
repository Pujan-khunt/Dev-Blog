---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogListItem from "@/components/BlogListItem.astro";

import { blogsByYear, years } from "@/data/blogs";
---

<BaseLayout
  title="writings · pujankhunt"
  description="All blog posts by Pujan Khunt."
>
  <a
    href="/"
    class="font-mono text-[0.75rem] text-fg-muted mb-10 inline-block transition-[color,transform] duration-200 hover:text-fg hover:-translate-x-0.5"
  >
    ↖ home
  </a>

  <p class="text-[0.92rem] font-bold mb-1">writings</p>
  <p class="text-[0.8rem] text-fg-muted mb-8">
    my thoughts and guides for stuff I forget.
  </p>

  {
    years.map((year) => (
      <div class="mb-8">
        <p class="text-[0.88rem] font-bold text-fg-muted mb-3">{year}</p>
        <div>
          {blogsByYear[year].map((blog) => (
            <BlogListItem {blog} />
          ))}
        </div>
      </div>
    ))
  }

  <p class="font-mono text-[0.72rem] text-fg-dim text-center pt-2 pb-1">
    that's all.
  </p>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogListItem from "@/components/BlogListItem.astro";
import RedirectLink from "@/components/RedirectLink.astro";

import { blogsByYear, years } from "@/data/blogs";
---

<BaseLayout title="writings" description="All blog posts by Pujan Khunt.">
  <!-- Back to Home Link -->
  <RedirectLink href="/" label="home" className="mb-4" arrowPosition="left" />

  <!-- Heading -->
  <h2 class="font-bold mb-1">Writings</h2>
  <p class="text-sm text-fg-muted mb-8">
    Thoughts and learnings as I explore and build.
  </p>

  <!-- Blogs Sorted Year Wise -->
  {
    years.map((year) => (
      <div class="mb-8">
        <p class="text-sm font-bold text-fg-muted mb-3">{year}</p>
        <div>
          {blogsByYear[year].map((blog) => (
            <BlogListItem {blog} />
          ))}
        </div>
      </div>
    ))
  }

  <!-- The End -->
  <p class="font-mono text-sm text-fg-dim text-center pt-2 pb-1">that's all.</p>
</BaseLayout>

---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import type { BlogEntry } from "@/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RedirectLink from "@/components/RedirectLink.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
};

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, readingTime, tags, heroImage } = post.data;

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}
---

<BaseLayout title={`${title} · pujankhunt`} description={title}>
  <!-- Back to Blogs Link -->
  <RedirectLink
    href="/blogs"
    label="blogs"
    className="mb-2"
    arrowPosition="left"
  />

  <!-- Hero image -->
  {
    heroImage && (
      <Image
        src={heroImage.src}
        alt={heroImage.alt}
        class="w-full aspect-16/7 object-cover rounded-sm border border-border mb-8 block"
      />
    )
  }

  <!-- Title -->
  <h1 class="text-2xl font-bold leading-8 mb-2">
    {title}
  </h1>

  <!-- Meta -->
  <p class="font-mono text-sm text-fg-dim mb-2">
    {formatDate(date)}<span class="mx-2">·</span>{readingTime}
  </p>

  <!-- Tags -->
  {
    tags.length > 0 && (
      <div class="flex gap-x-2 flex-wrap mb-10">
        {tags.map((tag) => (
          <span class="font-mono text-xs text-fg-dim border border-[#2e2e2e] py-1 px-2 rounded-xs">
            {tag}
          </span>
        ))}
      </div>
    )
  }

  <!-- Article body -->
  <div class="prose-sm prose dark:prose-invert max-w-none">
    <Content />
  </div>

  <p class="font-mono text-sm text-fg-dim text-center pt-6 pb-1">that's all.</p>
</BaseLayout>

---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import type { BlogEntry } from "@/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RedirectLink from "@/components/RedirectLink.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
};

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, readingTime, tags, heroImage } = post.data;

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}
---

<BaseLayout {title} description={title}>
  <!-- Back to Blogs Link -->
  <RedirectLink
    href="/blogs"
    label="blogs"
    className="mb-2"
    arrowPosition="left"
  />

  <!-- Hero image -->
  {
    heroImage && (
      <div class="xs:mb-0 mb-4 sm:mb-6 md:mb-8 lg:mb-0 rounded-sm overflow-hidden">
        <Image
          src={heroImage.src}
          alt={heroImage.alt}
          width={heroImage.src.width}
          height={heroImage.src.height}
          class="h-[40vh] min-h-50 md:h-[50vh] lg:h-[60vh] object-contain"
          loading="eager"
        />
      </div>
    )
  }

  <!-- Title -->
  <h1 class="text-2xl font-bold leading-8 mb-2">
    {title}
  </h1>

  <!-- Meta -->
  <p class="font-mono text-sm text-fg-dim mb-4">
    {formatDate(date)}<span class="mx-2">·</span>{readingTime}
  </p>

  <!-- Article body -->
  <div class="prose-sm prose dark:prose-invert max-w-none mb-4">
    <Content />
  </div>

  <!-- Tags -->
  {
    tags.length > 0 && (
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-2 font-mono text-sm text-fg-muted mb-4">
        <span>Tags:</span>
        {tags.map((tag) => (
          <span class="font-mono text-xs text-fg-dim border border-[#2e2e2e] py-1 px-2 rounded-xs">
            {tag}
          </span>
        ))}
      </div>
    )
  }

  <p class="font-mono text-sm text-fg-dim text-center pt-6 pb-1">that's all.</p>
</BaseLayout>

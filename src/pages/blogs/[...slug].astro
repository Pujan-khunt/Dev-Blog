---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { BlogEntry } from "@/types";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
};

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, readingTime, tags, heroImage } = post.data;

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}
---

<BaseLayout title={`${title} · pujankhunt`} description={title}>
  <!-- Back link -->
  <a
    href="/blogs"
    class="font-mono text-[0.75rem] text-fg-muted mb-10 inline-block transition-[color,transform] duration-200 hover:text-fg hover:-translate-x-0.5"
  >
    ↖ posts
  </a>

  <!-- Hero image -->
  {
    heroImage && (
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        class="w-full aspect-16/7 object-cover rounded-sm border border-border mb-8 block"
      />
    )
  }

  <!-- Title -->
  <h1 class="text-3xl font-bold leading-[1.3] tracking-[-0.01em] mb-[0.7rem]">
    {title}
  </h1>

  <!-- Meta -->
  <p class="font-mono text-[0.72rem] text-fg-dim mb-[0.9rem]">
    {formatDate(date)}<span class="mx-[0.3rem]">·</span>{readingTime}
  </p>

  <!-- Tags -->
  {
    tags.length > 0 && (
      <div class="flex gap-[0.35rem] flex-wrap mb-10">
        {tags.map((tag) => (
          <span class="font-mono text-[0.67rem] tracking-[0.04em] text-fg-dim border border-[#2e2e2e] px-[0.45rem] py-[0.1rem] rounded-xs">
            {tag}
          </span>
        ))}
      </div>
    )
  }

  <!-- Article body -->
  <!-- prose + dark:prose-invert = Tailwind typography styles, auto dark mode -->
  <!-- max-w-none = don't constrain width (BaseLayout already does that) -->
  <div class="prose-sm prose dark:prose-invert max-w-none">
    <Content />
  </div>

  <p class="font-mono text-[0.72rem] text-fg-dim text-center pt-6 pb-1">
    that's all.
  </p>
</BaseLayout>

---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { BlogEntry } from "@/types";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
};

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, readingTime, tags, heroImage } = post.data;

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}
---

<BaseLayout title={`${title} · pujankhunt`} description={title}>
  <!-- Back link -->
  <a
    href="/blogs"
    class="font-mono text-[0.75rem] text-fg-muted mb-10 inline-block transition-[color,transform] duration-200 hover:text-fg hover:-translate-x-0.5"
  >
    ↖ posts
  </a>

  <!-- Hero image -->
  {
    heroImage && (
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        class="w-full aspect-16/7 object-cover rounded-sm border border-border mb-8 block"
      />
    )
  }

  <!-- Title -->
  <h1
    class="text-[1.45rem] font-bold leading-[1.3] tracking-[-0.01em] mb-[0.7rem]"
  >
    {title}
  </h1>

  <!-- Meta -->
  <p class="font-mono text-[0.72rem] text-fg-dim mb-[0.9rem]">
    {formatDate(date)}<span class="mx-[0.3rem]">·</span>{readingTime}
  </p>

  <!-- Tags -->
  {
    tags.length > 0 && (
      <div class="flex gap-[0.35rem] flex-wrap mb-10">
        {tags.map((tag) => (
          <span class="font-mono text-[0.67rem] tracking-[0.04em] text-fg-dim border border-[#2e2e2e] px-[0.45rem] py-[0.1rem] rounded-xs">
            {tag}
          </span>
        ))}
      </div>
    )
  }

  <!-- Article body -->
  <!-- prose + dark:prose-invert = Tailwind typography styles, auto dark mode -->
  <!-- max-w-none = don't constrain width (BaseLayout already does that) -->
  <div class="prose dark:prose-invert max-w-none">
    <Content />
  </div>

  <div class="border-t border-border my-10"></div>

  <!-- Feedback -->
  <div class="mb-6">
    <h3 class="text-[0.85rem] font-bold mb-[0.35rem]">
      Feedback and suggestions
    </h3>
    <p class="text-[0.82rem] text-fg-muted leading-[1.8]">
      If you find any errors in this post, I&apos;d be happy to fix it. Reach me
      at
      <a
        href="mailto:pujankhunt2412@gmail.com"
        class="text-fg font-medium underline underline-offset-3 transition-opacity duration-200 hover:opacity-70"
      >
        pujankhunt2412@gmail.com
      </a>
    </p>
  </div>

  <!-- Thank you -->
  <div class="mb-6">
    <h3 class="text-[0.85rem] font-bold mb-[0.35rem]">
      Want to say thank you?
    </h3>
    <ul class="list-none p-0 mt-2">
      <li
        class="text-[0.82rem] text-fg-muted pl-5 relative before:content-['◦'] before:absolute before:left-0 before:text-fg-dim before:text-[0.7rem] before:top-[0.3rem]"
      >
        <a
          href="mailto:pujankhunt2412@gmail.com"
          class="text-fg font-medium underline underline-offset-3 transition-opacity duration-200 hover:opacity-70"
        >
          Send me an email
        </a> — if this post helped you, it will make my day.
      </li>
    </ul>
  </div>
</BaseLayout>

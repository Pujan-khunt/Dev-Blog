---
import { twMerge } from "tailwind-merge";

interface Props {
  href: string;
  label: string;
  className: string;
}

const { href, label, className } = Astro.props;
---

<a
  class={twMerge(
    className,
    "font-mono text-[0.72rem] text-fg-muted cursor-pointer block text-right mt-[0.8rem] no-underline transition-colors duration-200 hover:text-fg",
  )}
  {href}
>
  {label} ↗
</a>

---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div
  class="bg-background-dark p-8 flex flex-col justify-between aspect-square group hover:bg-surface transition-colors duration-300"
>
  <span
    class="font-mono text-muted text-[13px] group-hover:text-primary transition-colors duration-300"
    >{label}</span
  >
  <span
    class="font-display text-[48px] font-bold text-text-main leading-none mt-auto"
    >{value}</span
  >
</div>

---
import AuthorContactItem from "@/components/author/AuthorContactItem.astro";

const contacts = [
  { href: "https://github.com", text: "github.com/Pujan-khunt" },
  { href: "https://x.com", text: "x.com/pujankhunt2412" },
  {
    href: "mailto:contact@pujankhunt2412@gmail.com",
    text: "pujankhunt2412@gmail.com",
  },
];
---

<div class="pt-8 border-t border-border-color">
  <h2 class="font-mono text-muted text-[13px] mb-6">// contact_protocols</h2>
  <ul class="space-y-4 font-mono text-[15px] flex flex-col items-start">
    {
      contacts.map((contact) => (
        <AuthorContactItem href={contact.href} text={contact.text} />
      ))
    }
  </ul>
</div>

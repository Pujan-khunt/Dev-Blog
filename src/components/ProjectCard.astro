---
import GopherIcon from "@/svg/Gopher.astro";
import AstroIcon from "@/svg/Astro.astro";
import JavaScriptIcon from "@/svg/JavaScript.astro";
import type { Project } from "@/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  class="border hover:border-border-hover border-border p-4 cursor-pointer transition-all duration-250 hover:-translate-y-1 no-underline"
  target="_blank"
  rel="noopener noreferrer"
  href={project.href}
>
  <!-- Card Title -->
  <h3
    class="text-sm font-medium text-fg flex justify-between items-center mb-1.5"
  >
    <div class="flex items-center gap-1">
      {project.type === "golang" && <GopherIcon className="w-4 h-4" />}
      {project.type === "astro" && <AstroIcon className="w-4 h-4" />}
      {project.type === "javascript" && <JavaScriptIcon className="w-4 h-4" />}
      {project.title}
    </div>
    <span class="text-md text-fg-dim">↗</span>
  </h3>

  <!-- Card Summary -->
  <p class="text-xs text-fg-muted leading-5">
    {project.summary}
  </p>
</a>

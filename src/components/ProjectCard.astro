---
import GopherIcon from "@/svg/Gopher.astro";
import AstroIcon from "@/svg/Astro.astro";
import JavaScriptIcon from "@/svg/JavaScript.astro";
import type { Project } from "@/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  class="border border-border p-4 cursor-pointer transition-all duration-250 hover:-translate-y-1 hover:dark:border-dark-border-hover hover:border-dark-border no-underline"
  target="_blank"
  rel="noopener noreferrer"
  href={project.href}
>
  <!-- Card Title -->
  <div
    class="text-[0.85rem] font-medium text-fg flex justify-between items-center mb-[0.3rem]"
  >
    <div class="flex items-center gap-1">
      {project.type === "golang" && <GopherIcon className="w-4 h-4" />}
      {project.type === "astro" && <AstroIcon className="w-4 h-4" />}
      {project.type === "javascript" && <JavaScriptIcon className="w-4 h-4" />}
      {project.title}
    </div>
    <span class="text-[0.75rem] text-fg-dim">↗</span>
  </div>

  <!-- Card Summary -->
  <div class="text-[0.78rem] text-fg-muted leading-[1.6]">
    {project.summary}
  </div>
</a>

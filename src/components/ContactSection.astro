---
import ContactItem from "@/components/ContactItem.astro";
import { contacts } from "@/data/contacts";
---

<!-- Section Heading -->
<p class="font-bold mb-2 mt-8 sm:mt-12">Contact</p>

<!-- Section Data -->
<p class="text-fg-muted text-sm leading-6">
  connect with me on

  {
    contacts.map((contact, index) => (
      <>
        <ContactItem {contact} />

        {index < contacts.length - 2 && (
          <span class="m-0.5 text-fg-dim">·</span>
        )}

        {index === contacts.length - 2 && (
          <>&nbsp;or reach out to me at my&nbsp;</>
        )}
      </>
    ))
  }
</p>

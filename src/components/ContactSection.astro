---
import ContactItem from "@/components/ContactItem.astro";
import { contacts } from "@/data/contacts";
---

<!-- Section Heading -->
<p class="text-[0.92rem] font-bold mb-[0.4rem] mt-12">contact</p>

<!-- Section Data -->
<p class="text-[0.82rem] text-fg-muted leading-[1.9]">
  connect with me on

  {
    contacts.map((contact, index) => (
      <>
        <ContactItem {contact} />

        {index < contacts.length - 2 && (
          <span class="mx-[0.3rem] text-fg-dim">·</span>
        )}

        {index === contacts.length - 2 && (
          <>&nbsp;or reach out to me at&nbsp;</>
        )}
      </>
    ))
  }
</p>

---
const currentYear = new Date().getFullYear();
---

<footer
  class="mx-auto mt-16 pt-6 px-6 pb-10 flex justify-between items-center border-t border-border"
>
  <span class="font-mono text-[0.68rem] text-fg-dim"
    >© {currentYear} pujankhunt</span
  >

  <div class="font-mono text-[0.68rem] text-fg-dim flex gap-4 items-center">
    <span>
      theme:
      <button
        class="cursor-pointer text-fg-muted underline underline-offset-3 font-mono text-[0.68rem] transition-colors duration-200 hover:text-fg"
        id="theme-toggle"
      >
        light
      </button>
    </span>
    <span>v1.0</span>
  </div>
</footer>

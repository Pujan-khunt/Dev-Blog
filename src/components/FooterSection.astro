---
import { twMerge } from "tailwind-merge";

const currentYear = new Date().getFullYear();

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<footer
  class={twMerge(
    className,
    "pt-6 pb-10 flex justify-between items-center border-t border-border",
  )}
>
  <span class="font-mono text-xs text-fg-dim">© {currentYear} pujankhunt</span>

  <div class="font-mono text-xs text-fg-dim flex gap-4 items-center">
    <span>
      theme:
      <!-- id is required for querySelector in theme toggle script -->
      <button
        class="cursor-pointer text-fg-muted underline underline-offset-3 font-mono transition-colors duration-200 hover:text-fg"
        id="theme-toggle"
      >
        light
      </button>
    </span>
    <span>v1.0</span>
  </div>
</footer>

---
import MainNavItem from "@/components/home/MainNavItem.astro";

const navItems = [
  {
    material_icon: "home",
    text: "Home",
    href: "/",
  },
  {
    material_icon: "folder_open",
    text: "Archive",
    href: "/archive",
  },
  {
    material_icon: "person",
    text: "Author",
    href: "/author",
  },
];
---

<nav
  class="flex md:flex-col gap-2 mb-0 md:mb-12 shrink-0 border-r md:border-r-0 border-border-color pr-6 md:pr-0"
>
  {
    navItems.map((navItem) => (
      <MainNavItem
        material_icon={navItem.material_icon}
        text={navItem.text}
        href={navItem.href}
      />
    ))
  }
</nav>

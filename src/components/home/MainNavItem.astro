---
interface Props {
  material_icon: string;
  text: string;
  href: string;
}

const { material_icon, text, href } = Astro.props;
---

<a
  class="flex bg-none items-center gap-3 px-3 py-2 bg-surface border border-border-color text-text-main group transition-none"
  {href}
>
  <span aria-hidden="true" class="material-symbols-outlined text-lg"
    >{material_icon}</span
  >
  <span
    class="font-mono text-sm tracking-wide group-hover:text-primary transition-none"
    >{text}</span
  >
</a>

---
import Download from "@/svg/Download.astro";

interface Props {
  photoSrc: string;
  resumeHref: string;
}

const { photoSrc, resumeHref } = Astro.props;
---

<a
  class="cursor-pointer hover:text-(--fg) hover:border-[#555] text-(--fg-muted) border border-(--border) rounded-2xl hover:-translate-y-1 in-[.light]:border-(--border) transition-all duration-200"
  target="_blank"
  href={resumeHref}
>
  <img
    class="w-44 h-44 min-w-44 rounded-t-2xl object-cover"
    src={photoSrc}
    id="home-avatar"
    alt="Pujan Khunt"
  />
  <div
    class="group flex items-center justify-center rounded-b-2xl gap-[0.4rem] font-mono text-[0.72rem] tracking-[0.04em] no-underline py-2 px-[0.65rem] rounded-xs transition-all duration-200 ease-(--ease) w-full"
  >
    <Download />
    resume.pdf
  </div>
</a>

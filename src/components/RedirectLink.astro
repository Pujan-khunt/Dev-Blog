---
import { twMerge } from "tailwind-merge";
import TopRightArrow from "@/svg/TopRightArrow.astro";
import TopLeftArrow from "@/svg/TopLeftArrow.astro";
import clsx from "clsx";

interface Props {
  href: string;
  label: string;
  arrowPosition: "left" | "right";
  className?: string;
}

const { href, label, arrowPosition, className } = Astro.props;
---

<a
  class={twMerge(
    clsx(
      className,
      arrowPosition === "left" && "flex-row-reverse",
      arrowPosition === "right" && "flex-row",
      "font-mono text-xs flex items-start justify-end text-fg-muted cursor-pointer mt-4 no-underline transition-colors duration-200 hover:text-fg",
    ),
  )}
  {href}
>
  {label}
  {arrowPosition === "left" && <TopLeftArrow className="w-3 h-3" />}
  {arrowPosition === "right" && <TopRightArrow className="w-3 h-3" />}
</a>

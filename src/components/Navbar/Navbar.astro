---
import Logo from "@/components/Navbar/Logo.astro";
import NavLinks from "@/components/Navbar/NavLinks.astro";
import ThemeToggle from "@/components/Navbar/ThemeToggle.astro";
---

<nav class="sticky top-0 z-50 w-full border-b border-bg-secondary dark:border-gray-800 bg-bg/80 dark:bg-[#0F172A]/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <Logo />
      <div class="flex items-center gap-4">
        <NavLinks />
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>

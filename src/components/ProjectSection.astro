---
import ProjectCard from "@/components/ProjectCard.astro";

import SectionHeading from "@/components/SectionHeading.astro";
import SectionDescription from "@/components/SectionDescription.astro";
import RedirectLink from "@/components/RedirectLink.astro";

import { projects } from "@/data/projects";
---

<!-- Section Heading -->
<SectionHeading
  className="mb-1 mt-8 sm:mt-12"
  label="Projects"
  href="/projects"
/>

<!-- Section Description -->
<SectionDescription
  className="mb-5"
  description="stuff I built in my free time."
/>

<!-- Section Data -->
<div class="grid grid-cols-1 min-[521px]:grid-cols-2 gap-3 mb-2">
  {projects.map((project) => <ProjectCard {project} />)}
</div>

<!-- Section Page Redirect Link -->
<RedirectLink
  className="mt-2"
  href="/projects"
  label="All projects"
  arrowPosition="right"
/>

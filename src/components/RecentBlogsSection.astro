---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const recentPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<div class="animate-[fadeUp_0.4s_cubic-bezier(.4,0,.2,1)_both_0.15s]">
  <div class="mb-[0.3rem]">
    <a
      class="text-[0.92rem] font-bold text-(--fg) cursor-pointer no-underline inline-flex items-center gap-[0.2rem] transition-opacity duration-200 hover:opacity-70"
      href="/blogs"
    >
      writings ↗
    </a>
  </div>
  <p class="text-[0.8rem] text-(--fg-muted) mb-[1.2rem]">
    my thoughts and guides for stuff I forget.
  </p>

  <div class="mb-2" id="home-list">
    {
      recentPosts.map((post) => (
        <div class="group grid grid-cols-[5.5rem_1fr] min-[521px]:grid-cols-[5rem_1fr_auto] gap-x-4 gap-y-[0.3rem] items-baseline py-[0.65rem] px-0 border-b border-(--border) cursor-pointer transition-[padding-left] duration-200 ease-(--ease) first:border-t first:border-(--border) hover:pl-2">
          <span class="font-mono text-[0.7rem] text-(--fg-dim) whitespace-nowrap">
            {post.data.date.toLocaleDateString()}
          </span>
          <a
            href={`/blog/${post.slug}`}
            class="text-[0.88rem] font-medium text-(--fg) no-underline transition-colors duration-200 ease-(--ease) group-hover:text-white in-[.light]:group-hover:text-black"
          >
            {post.data.title}
          </a>
          <span class="font-mono text-[0.7rem] text-(--fg-dim) whitespace-nowrap text-right hidden min-[521px]:block">
            {post.data.readingTime}
          </span>
        </div>
      ))
    }
  </div>

  <a
    class="font-mono text-[0.72rem] text-(--fg-muted) cursor-pointer block text-right mt-[0.8rem] no-underline transition-colors duration-200 hover:text-(--fg)"
    href="/blogs"
  >
    All writings ↗
  </a>
</div>

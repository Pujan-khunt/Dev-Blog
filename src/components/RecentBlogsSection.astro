---
import BlogListItem from "@/components/BlogListItem.astro";

import SectionHeading from "@/components/SectionHeading.astro";
import SectionDescription from "@/components/SectionDescription.astro";
import RedirectLink from "@/components/RedirectLink.astro";

import { recentBlogs } from "@/data/blogs";
---

<!-- Section Heading -->
<SectionHeading label="Blogs" href="/blogs" className="mb-1" />

<!-- Section Description -->
<SectionDescription
  className="mb-5"
  description="Thoughts and learnings as I explore and build."
/>

<!-- Section Data -->
<div class="mb-2">
  {recentBlogs.map((blog) => <BlogListItem {blog} />)}
</div>

<!-- Section Page Redirect Link -->
<RedirectLink href="/blogs" label="All writings" arrowPosition="right" />

---
import BlogListItem from "@/components/BlogListItem.astro";

import SectionHeading from "@/components/SectionHeading.astro";
import SectionDescription from "@/components/SectionDescription.astro";
import SectionRedirectLink from "@/components/SectionRedirectLink.astro";

import { blogs } from "@/data/blogs";
---

<!-- Section Heading -->
<SectionHeading label="writings" href="/blogs" className="mb-[0.3rem]" />

<!-- Section Description -->
<SectionDescription
  className="mb-[1.2rem]"
  description="my thoughts and guides for stuff I forget."
/>

<!-- Section Data -->
<div class="mb-2">
  {
    blogs.map((post) => (
      <BlogListItem
        date={post.data.date.toLocaleDateString()}
        slug={post.slug}
        title={post.data.title}
        readingTime={post.data.readingTime}
      />
    ))
  }
</div>

<!-- Section Page Redirect Link -->
<SectionRedirectLink
  className="mt-[0.8rem]"
  href="/blogs"
  label="All writings"
/>

---
interface Socials {
  twitter?: string;
  github?: string;
  website?: string;
}

interface Author {
  name: string;
  bio?: string;
  avatar?: string;
  socials?: Socials;
}

interface Props {
  author: Author;
}

const { author } = Astro.props;
---

<footer class="mt-16 pt-8 border-t border-bg-secondary dark:border-gray-700">
  <div class="bg-bg-secondary dark:bg-gray-800 rounded-xl p-6 flex gap-4 items-start">
    {author.avatar && (
      <img
        src={author.avatar}
        alt={author.name}
        class="w-16 h-16 rounded-full object-cover flex-shrink-0"
      />
    )}
    <div class="flex-1">
      <h3 class="text-lg font-semibold text-secondary dark:text-primary mb-1">
        {author.name}
      </h3>
      {author.bio && (
        <p class="text-text-muted dark:text-gray-400 text-sm mb-3">
          {author.bio}
        </p>
      )}
      {author.socials && (
        <div class="flex gap-3">
          {author.socials.twitter && (
            <a
              href={author.socials.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-primary transition-colors"
              aria-label="Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          )}
          {author.socials.github && (
            <a
              href={author.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-primary transition-colors"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          )}
          {author.socials.website && (
            <a
              href={author.socials.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-primary transition-colors"
              aria-label="Website"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</footer>

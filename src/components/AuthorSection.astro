---
import { author } from "@/data/author";
import { Image } from "astro:assets";
import Download from "@/svg/Download.astro";
import { twMerge } from "tailwind-merge";

interface Props {
  className: string;
}

const { className } = Astro.props;
---

<div
  class={twMerge(
    className,
    "flex flex-col-reverse sm:flex-row items-center gap-4",
  )}
>
  <!-- Author Information -->
  <div class="flex flex-col items-center sm:items-start px-4 sm:px-0 sm:pr-6">
    <!-- Greeting -->
    <p class="text-[1.1rem] font-bold mb-2">{author.greeting}</p>

    <!-- Bio -->
    <p class="text-[0.88rem] text-fg-muted leading-[1.85]">{author.bio}</p>

    <!-- Quote -->
    <i class="text-[0.9rem] mt-4">{author.quote}</i>
  </div>

  <!-- Author Profile Picture + Resume -->
  <a
    class="text-fg border border-border hover:border-border-hover rounded-2xl hover:-translate-y-1 transition-all duration-200 cursor-pointer"
    target="_blank"
    href={author.resumeHref}
  >
    <!-- Profile Picture -->
    <Image
      priority={true}
      src={author.profileImage}
      class="w-40 h-40 min-w-40 sm:w-42 sm:h-42 sm:min-w-42 rounded-2xl sm:rounded-b-none object-cover"
      width={336}
      alt="Pujan Khunt"
      id="home-avatar"
    />

    <!-- Resume Button -->
    <div
      class="hidden sm:flex items-center justify-center rounded-b-2xl gap-[0.4rem] font-mono text-[0.65rem] sm:text-[0.72rem] tracking-[0.04em] no-underline py-2 px-[0.65rem] transition-all duration-200 ease-ease w-full"
    >
      <Download />
      resume.pdf
    </div>
  </a>
</div>

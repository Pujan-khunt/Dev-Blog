---
import { author } from "@/data/author";
import { Image } from "astro:assets";
import Download from "@/svg/Download.astro";
import { twMerge } from "tailwind-merge";

interface Props {
  className: string;
}

const { className } = Astro.props;
---

<div
  class={twMerge(
    className,
    "flex flex-col-reverse sm:flex-row items-center gap-4",
  )}
>
  <!-- Author Information -->
  <div class="flex flex-col items-center sm:items-start sm:px-0 sm:pr-6">
    <!-- Greeting -->
    <h1 class="text-2xl font-bold mb-2">{author.greeting}</h1>

    <!-- Bio -->
    <p class="text-sm text-fg-muted leading-7">{author.bio}</p>

    <!-- Quote -->
    <i class="text-sm mt-4">{author.quote}</i>
  </div>

  <!-- Author Profile Picture + Resume -->
  <a
    class="text-fg border border-border hover:border-border-hover rounded-2xl hover:-translate-y-1 transition-all duration-200 cursor-pointer"
    target="_blank"
    href={author.resumeHref}
  >
    <!-- Profile Picture -->
    <Image
      format="avif"
      priority={true}
      src={author.profileImage}
      class="w-40 h-40 min-w-40 sm:w-42 sm:h-42 sm:min-w-42 rounded-2xl sm:rounded-b-none object-cover"
      width={336}
      alt="Pujan Khunt"
    />

    <!-- Resume Button -->
    <div
      class="hidden sm:flex sm:items-center sm:justify-center rounded-b-2xl gap-1.5 font-mono sm:text-xs py-2 transition-all duration-200 ease-ease w-full"
    >
      <Download />
      resume.pdf
    </div>
  </a>
</div>

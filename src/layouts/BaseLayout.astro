---
import "@/global.css";

import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";

import interUrl400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url"
import interUrl500 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url"
import interUrl700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url"
import jetbrainUrl400 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url"

import FooterSection from "@/components/FooterSection.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pujan's Developer Blog",
  description = "My thoughts and guides for stuff I forget.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Inline script (NO using src) for FOUC prevention -->
    <!-- prettier-ignore -->
    <script is:inline>!function(d,t){d.classList.toggle("dark",t!=="light")}(document.documentElement,localStorage.getItem("theme"));</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Pujan's Site" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preloading fonts -->
    <link rel="preload" href={interUrl400} as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href={interUrl500} as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href={interUrl700} as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href={jetbrainUrl400} as="font" type="font/woff2" crossorigin="anonymous"/>
  </head>
  <body
    class="bg-bg text-fg pt-10 px-6 sm:pt-20 max-w-2xl mx-auto font-sans leading-6 antialiased min-h-screen flex flex-col"
  >
    <div class="flex-1">
      <slot />
    </div>
    <FooterSection className="mt-12" />
    <script src="../theme-toggler.min.js"></script>
    <script is:inline async data-collect-dnt="true" src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>

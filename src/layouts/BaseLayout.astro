---
import "@/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";

import FooterSection from "@/components/FooterSection.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pujan's Developer Blog",
  description = "My thoughts and guides for stuff I forget.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="text-sm">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body
    class="bg-bg text-fg pt-20 max-w-2xl mx-auto font-sans leading-[1.7] antialiased min-h-screen"
  >
    <slot />
    <FooterSection />
    <script>
      const themeBtn = document.getElementById("theme-toggle");
      let isDark = false;

      if (themeBtn) {
        themeBtn.addEventListener("click", () => {
          isDark = !isDark;
          document.documentElement.classList.toggle("dark", isDark);
          themeBtn.textContent = isDark ? "dark" : "light";
        });
      }
    </script>
  </body>
</html>

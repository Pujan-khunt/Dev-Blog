---
import "@/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";

import FooterSection from "@/components/FooterSection.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pujan's Developer Blog",
  description = "My thoughts and guides for stuff I forget.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="lg:text-lg md:text-md sm:text-sm text-xs">
  <head>
    <!-- Inline script (NO using src) for FOUC prevention -->
    <!-- prettier-ignore -->
    <script is:inline>!function(d,t){d.classList.toggle("dark",t!=="light")}(document.documentElement,localStorage.getItem("theme"));</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body
    class="bg-bg text-fg pt-16 px-8 sm:pt-20 max-w-3xl mx-auto font-sans leading-[1.7] antialiased min-h-screen flex flex-col"
  >
    <div class="flex-1">
      <slot />
    </div>
    <FooterSection className="mt-12" />
    <script src="../theme-toggler.min.js"></script>
  </body>
</html>
